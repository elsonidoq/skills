{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.config/opencode/AGENTS.md"],
  "plugins": [
  {
    "package": "file:///home/dev/.config/opencode/opencode-claude-memory-v2-port/dist",
    "options": {}
  },

  "@ex-machina/opencode-anthropic-auth@next",

  {
    "package": "jev-for-all@0.1.0",
    "options": {
      "skills": {
        "enabled": true
      },
      "tools": {
        "enabled": true
      }
    }
  }
  ],
  "shell": "/Users/elsonidoq/.local/bin/opencode-bash",
  "provider": {
    "anthropic": {
      "models": {
        "claude-fable-5.1": {
          "name": "Claude Fable 5.1",
          "options": {
            "thinking": {
              "type": "adaptive",
              "blockBinding": false
            }
          }
        },
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5"
        },
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5"
        }
      }
    },
    "openai": {
      "models": {
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna"
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra"
        },
        "gpt-6-sol": {
          "name": "GPT-6 Sol"
        },
        "gpt-6-astra": {
          "name": "GPT-6 Astra"
        }
      }
    },
    "openrouter": {
      "models": {
        "anthropic/claude-opus-5.5": {
          "name": "Claude Opus 5.5"
        },
        "deepseek/deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash 0731"
        },
        "deepseek/ideepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash"
        }
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "paddle": {
      "type": "local",
      "command": ["npx", "-y", "@paddle/paddle-mcp"],
      "enabled": true
    }
  }
}
