{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coherence.invalid/design/v1/projection.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "run_id": {
          "$ref": "shared.schema.json#/$defs/id"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "record_id": {
          "$ref": "shared.schema.json#/$defs/id"
        },
        "timestamp": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "state"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "created",
                "preflight",
                "running",
                "blocked",
                "interrupted",
                "implementation_complete",
                "reviewing",
                "accepted",
                "cancelled",
                "final_failure",
                "parking",
                "waiting_owner_input",
                "paused"
              ]
            },
            "acceptance": {
              "enum": [
                "pending",
                "accepted",
                "blocked",
                "failed"
              ]
            },
            "config_hash": {
              "$ref": "shared.schema.json#/$defs/digest"
            },
            "checkpoint_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "task_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "node_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "attempt_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "gate_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "blocker": {
              "type": [
                "string",
                "null"
              ]
            },
            "projection_lag": {
              "type": "integer",
              "minimum": 0
            },
            "alarms": {
              "type": "array",
              "items": {
                "$ref": "shared.schema.json#/$defs/alarm"
              }
            },
            "pending_question_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "outbox_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "control_stage": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                null,
                "received",
                "queued",
                "sdk_delivered",
                "worker_acknowledged",
                "blocked",
                "cancelled",
                "reconciled"
              ]
            },
            "recorded_state": {
              "type": "string"
            },
            "controller_live": {
              "type": ["boolean", "null"]
            }
          },
          "required": [
            "status",
            "acceptance",
            "config_hash",
            "checkpoint_ref",
            "task_id",
            "node_id",
            "attempt_id",
            "gate_ref",
            "blocker",
            "projection_lag",
            "alarms"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "alarms": {
                    "contains": {
                      "properties": {
                        "state": {
                          "const": "active"
                        }
                      },
                      "required": [
                        "state"
                      ]
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "status": {
                    "const": "blocked"
                  },
                  "acceptance": {
                    "const": "blocked"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "waiting_owner_input"
                  }
                }
              },
              "then": {
                "required": [
                  "pending_question_ref"
                ],
                "properties": {
                  "pending_question_ref": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "seq",
        "record_id",
        "timestamp",
        "kind",
        "payload"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "run_id": {
          "$ref": "shared.schema.json#/$defs/id"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "record_id": {
          "$ref": "shared.schema.json#/$defs/id"
        },
        "timestamp": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "event"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "$ref": "shared.schema.json#/$defs/id"
            },
            "operation_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "attempt_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "details_schema": {
              "$ref": "shared.schema.json#/$defs/id"
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "kind",
            "operation_ref",
            "attempt_ref",
            "details_schema",
            "details"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "ORPHAN_PROCESS"
                  }
                }
              },
              "then": {
                "properties": {
                  "details": {
                    "$ref": "shared.schema.json#/$defs/alarm"
                  },
                  "details_schema": {
                    "const": "alarm.v1"
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "seq",
        "record_id",
        "timestamp",
        "kind",
        "payload"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "run_id": {
          "$ref": "shared.schema.json#/$defs/id"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "record_id": {
          "$ref": "shared.schema.json#/$defs/id"
        },
        "timestamp": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "metric"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "task_id": {
              "$ref": "shared.schema.json#/$defs/id"
            },
            "attempt_id": {
              "$ref": "shared.schema.json#/$defs/id"
            },
            "node_id": {
              "$ref": "shared.schema.json#/$defs/id"
            },
            "role": {
              "enum": [
                "implement",
                "repair",
                "review",
                "code",
                "gate"
              ]
            },
            "requested_profile": {
              "oneOf": [
                {
                  "$ref": "shared.schema.json#/$defs/profile"
                },
                {
                  "type": "null"
                }
              ]
            },
            "observed_runtime": {
              "oneOf": [
                {
                  "$ref": "shared.schema.json#/$defs/binding_observation"
                },
                {
                  "type": "null"
                }
              ]
            },
            "observed_request": {
              "oneOf": [
                {
                  "$ref": "shared.schema.json#/$defs/binding_observation"
                },
                {
                  "type": "null"
                }
              ]
            },
            "provider_acknowledged": {
              "oneOf": [
                {
                  "$ref": "shared.schema.json#/$defs/binding_observation"
                },
                {
                  "type": "null"
                }
              ]
            },
            "skill_requested": {
              "type": [
                "string",
                "null"
              ]
            },
            "skill_observed": {
              "type": [
                "string",
                "null"
              ]
            },
            "session_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "context_group": {
              "type": [
                "string",
                "null"
              ]
            },
            "reused": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "selection_reason": {
              "type": "string",
              "minLength": 1
            },
            "started_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "ended_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "elapsed_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "outcome": {
              "enum": [
                "reserved",
                "dispatching",
                "active",
                "settling",
                "settled",
                "audited",
                "committed",
                "failed",
                "blocked",
                "stopped",
                "interrupted",
                "orphan",
                "unknown",
                "parked",
                "continuing"
              ]
            },
            "retry_count": {
              "type": "integer",
              "minimum": 0
            },
            "repair_count": {
              "type": "integer",
              "minimum": 0
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "$ref": "shared.schema.json#/$defs/id"
              },
              "minItems": 0
            },
            "baseline_sha": {
              "type": [
                "string",
                "null"
              ]
            },
            "result_sha": {
              "type": [
                "string",
                "null"
              ]
            },
            "input_tokens": {
              "$ref": "shared.schema.json#/$defs/observation"
            },
            "output_tokens": {
              "$ref": "shared.schema.json#/$defs/observation"
            },
            "cache_read_tokens": {
              "$ref": "shared.schema.json#/$defs/observation"
            },
            "cache_write_tokens": {
              "$ref": "shared.schema.json#/$defs/observation"
            },
            "context_start": {
              "$ref": "shared.schema.json#/$defs/observation"
            },
            "context_end": {
              "$ref": "shared.schema.json#/$defs/observation"
            },
            "threshold_start": {
              "$ref": "shared.schema.json#/$defs/observation"
            },
            "threshold_end": {
              "$ref": "shared.schema.json#/$defs/observation"
            },
            "headroom_start": {
              "$ref": "shared.schema.json#/$defs/observation"
            },
            "headroom_end": {
              "$ref": "shared.schema.json#/$defs/observation"
            },
            "telemetry_provenance": {
              "type": "string",
              "minLength": 1
            },
            "unknown_reasons": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "supersedes": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "task_id",
            "attempt_id",
            "node_id",
            "role",
            "requested_profile",
            "observed_runtime",
            "observed_request",
            "provider_acknowledged",
            "skill_requested",
            "skill_observed",
            "session_id",
            "context_group",
            "reused",
            "selection_reason",
            "started_at",
            "ended_at",
            "elapsed_ms",
            "outcome",
            "retry_count",
            "repair_count",
            "evidence_refs",
            "baseline_sha",
            "result_sha",
            "input_tokens",
            "output_tokens",
            "cache_read_tokens",
            "cache_write_tokens",
            "context_start",
            "context_end",
            "threshold_start",
            "threshold_end",
            "headroom_start",
            "headroom_end",
            "telemetry_provenance",
            "unknown_reasons",
            "supersedes"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "role": {
                    "enum": [
                      "code",
                      "gate"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "requested_profile": {
                    "type": "null"
                  },
                  "observed_runtime": {
                    "type": "null"
                  },
                  "observed_request": {
                    "type": "null"
                  },
                  "provider_acknowledged": {
                    "type": "null"
                  },
                  "session_id": {
                    "type": "null"
                  },
                  "skill_requested": {
                    "type": "null"
                  },
                  "skill_observed": {
                    "type": "null"
                  },
                  "reused": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "seq",
        "record_id",
        "timestamp",
        "kind",
        "payload"
      ]
    }
  ]
}
