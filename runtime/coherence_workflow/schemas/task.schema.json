{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coherence.invalid/design/v1/task.schema.json",
  "$defs": {
    "task": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "depends": {"type": "array", "items": {"type": "string"}},
        "generated_outputs": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["id"],
      "anyOf": [{"required": ["outcome"]}, {"required": ["description"]}]
    }
  },
  "oneOf": [
    {"type": "array", "items": {"$ref": "#/$defs/task"}},
    {
      "type": "object",
      "properties": {"tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}},
      "required": ["tasks"]
    }
  ]
}
