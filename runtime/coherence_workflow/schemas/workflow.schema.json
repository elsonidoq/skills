{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coherence.invalid/design/v1/workflow.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "workflow_id": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "start": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "shared.schema.json#/$defs/id"
              },
              "handler": {
                "$ref": "shared.schema.json#/$defs/id"
              },
              "handler_version": {
                "type": "string",
                "minLength": 1
              },
              "outcomes": {
                "type": "array",
                "items": {
                  "$ref": "shared.schema.json#/$defs/id"
                },
                "minItems": 1
              },
              "transitions": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "$ref": "shared.schema.json#/$defs/id"
                }
              },
              "side_effects": {
                "type": "array",
                "items": {
                  "enum": [
                    "read",
                    "files",
                    "process",
                    "git",
                    "owner_gate",
                    "conversation"
                  ]
                },
                "minItems": 0
              },
              "type": {
                "const": "agent"
              },
              "role": {
                "enum": [
                  "implement",
                  "repair",
                  "review"
                ]
              },
              "profile": {
                "$ref": "shared.schema.json#/$defs/id"
              },
              "skill": {
                "$ref": "shared.schema.json#/$defs/id"
              },
              "session_policy": {
                "$ref": "shared.schema.json#/$defs/session_policy"
              },
              "max_repair_attempts": {
                "type": "integer",
                "minimum": 0
              },
              "max_retries": {
                "type": "integer",
                "minimum": 0
              },
              "tools": {
                "type": "array",
                "items": {
                  "$ref": "shared.schema.json#/$defs/id"
                }
              },
              "permissions": {
                "type": "array",
                "items": {
                  "$ref": "shared.schema.json#/$defs/id"
                }
              }
            },
            "required": [
              "id",
              "handler",
              "handler_version",
              "outcomes",
              "transitions",
              "side_effects",
              "type",
              "role",
              "profile",
              "skill",
              "session_policy",
              "max_repair_attempts",
              "max_retries",
              "tools",
              "permissions"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "shared.schema.json#/$defs/id"
              },
              "handler": {
                "$ref": "shared.schema.json#/$defs/id"
              },
              "handler_version": {
                "type": "string",
                "minLength": 1
              },
              "outcomes": {
                "type": "array",
                "items": {
                  "$ref": "shared.schema.json#/$defs/id"
                },
                "minItems": 1
              },
              "transitions": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "$ref": "shared.schema.json#/$defs/id"
                }
              },
              "side_effects": {
                "type": "array",
                "items": {
                  "enum": [
                    "read",
                    "files",
                    "process",
                    "git",
                    "owner_gate",
                    "conversation"
                  ]
                },
                "minItems": 0
              },
              "type": {
                "enum": [
                  "code",
                  "gate"
                ]
              },
              "max_retries": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "handler",
              "handler_version",
              "outcomes",
              "transitions",
              "side_effects",
              "type",
              "max_retries"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "shared.schema.json#/$defs/id"
              },
              "handler": {
                "$ref": "shared.schema.json#/$defs/id"
              },
              "handler_version": {
                "type": "string",
                "minLength": 1
              },
              "outcomes": {
                "type": "array",
                "maxItems": 0
              },
              "transitions": {
                "type": "object",
                "maxProperties": 0
              },
              "side_effects": {
                "type": "array",
                "items": {
                  "enum": [
                    "read",
                    "files",
                    "process",
                    "git",
                    "owner_gate",
                    "conversation"
                  ]
                },
                "minItems": 0
              },
              "type": {
                "const": "terminal"
              }
            },
            "required": [
              "id",
              "handler",
              "handler_version",
              "outcomes",
              "transitions",
              "side_effects",
              "type"
            ]
          }
        ]
      },
      "minItems": 1
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "shared.schema.json#/$defs/profile"
      }
    },
    "skills": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "$ref": "shared.schema.json#/$defs/path"
          },
          "sha256": {
            "$ref": "shared.schema.json#/$defs/digest"
          },
          "resource_hash": {
            "$ref": "shared.schema.json#/$defs/digest"
          }
        },
        "required": [
          "path",
          "sha256",
          "resource_hash"
        ]
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_repair_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "min_free_tokens_before_compaction": {
          "type": "integer",
          "minimum": 0
        },
        "monitor_interval_ms": {
          "type": "integer",
          "minimum": 1
        },
        "telemetry_max_age_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "max_repair_attempts",
        "min_free_tokens_before_compaction",
        "monitor_interval_ms",
        "telemetry_max_age_ms"
      ]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkpoint": {
          "$ref": "shared.schema.json#/$defs/path"
        },
        "event_root": {
          "$ref": "shared.schema.json#/$defs/path"
        }
      },
      "required": [
        "checkpoint",
        "event_root"
      ]
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "shared.schema.json#/$defs/id"
      },
      "minItems": 0
    },
    "tool_capabilities": {
      "type": "array",
      "items": {
        "$ref": "shared.schema.json#/$defs/id"
      },
      "minItems": 0
    },
    "containment_capability": {
      "type": [
        "string",
        "null"
      ]
    },
    "settings_manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "shared.schema.json#/$defs/path"
        },
        "sha256": {
          "$ref": "shared.schema.json#/$defs/digest"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "standalone",
            "interactive_parent"
          ]
        },
        "question_transport": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_binding_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "question_tool": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "mode",
        "question_transport",
        "parent_binding_ref",
        "question_tool"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "interactive_parent"
              }
            }
          },
          "then": {
            "properties": {
              "question_transport": {
                "type": "string",
                "minLength": 1
              },
              "parent_binding_ref": {
                "type": "string",
                "minLength": 1
              },
              "question_tool": {
                "const": "ask_user"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "workflow_id",
    "registry_version",
    "start",
    "nodes",
    "profiles",
    "skills",
    "defaults",
    "storage",
    "permissions",
    "tool_capabilities",
    "containment_capability",
    "settings_manifest",
    "interaction"
  ]
}
