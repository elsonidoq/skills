node_modules
# Local credentials; never commit populated environment files.
.env
service.json
package.json
package-lock.json
bun.lock
opencode.json
opencode.jsonc
__pycache__
*.pyc

# Opt-in workflow runtime: private local state and isolated package/build artifacts.
.coherence/workflow/
runtime/.venv/
runtime/build/
runtime/dist/
runtime/*.egg-info/
workflow_monitor/.venv/
workflow_monitor/build/
# Generated monitor web build and Playwright output; not retained source.
workflow_monitor/web/dist/
workflow_monitor/web/test-results/

# The ported plugin under opencode-claude-memory-v2-port/ is tracked as source.
# Track its manifest and lockfile so `bun install && bun run build` reproduces it;
# node_modules/ and its build output dist/ stay ignored (owned by the port's own .gitignore).
!opencode-claude-memory-v2-port/package.json
!opencode-claude-memory-v2-port/bun.lock
