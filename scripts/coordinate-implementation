#!/bin/sh
# Suite-relative resources; no install, auth refresh or project inference.
set -eu
SCRIPT=$(readlink -f -- "$0")
ROOT=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")/.." && pwd)
export PYTHONPATH="$ROOT/runtime${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONDONTWRITEBYTECODE=1
exec "${COHERENCE_PYTHON:-python3}" -I -B -c 'import sys,runpy;sys.path.insert(0,sys.argv.pop(1));runpy.run_module("coherence_workflow.cli",run_name="__main__",alter_sys=True)' "$ROOT/runtime" "$@"
